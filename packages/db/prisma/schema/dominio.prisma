// Modelos de dominio de dent-view. Los modelos de Better Auth (User, Organization, Member…) van en auth.prisma.
// Organization = tenant (centro de imágenes).

// Persona = solo clave de identidad (tipo + número de documento). Los datos del paciente viven en PacienteTenant;
// las columnas de nombre/contacto se conservan por compatibilidad pero ya no se leen ni se editan.
model Persona {
  id              String           @id @default(cuid())
  tipoDocumento   String           @default("CC")
  numeroDocumento String
  nombre          String           @default("")
  fechaNacimiento DateTime?
  celular         String?
  correo          String?
  direccion       String?
  creadoEn        DateTime         @default(now())
  pacientes       PacienteTenant[]

  @@unique([tipoDocumento, numeroDocumento])
}

// Registro del paciente dentro de un centro: cada tenant es dueño de sus datos.
model PacienteTenant {
  id                     String                 @id @default(cuid())
  organizationId         String
  organization           Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  personaId              String
  persona                Persona                @relation(fields: [personaId], references: [id])
  // Datos propios del centro: nunca se comparten con otros centros.
  nombre                 String
  fechaNacimiento        DateTime?
  celular                String?
  correo                 String?
  direccion              String?
  alertas                String? // alergias, embarazo, condiciones relevantes para el estudio
  notas                  String?
  fotoKey                String? // clave S3 de la foto de perfil (tenants/{org}/pacientes/{id}/…); solo se sirve por ruta autenticada
  ultimaVisitaEn         DateTime? // fidelización: última atención (la mantiene la lógica de CRM)
  proximoControlEn       DateTime? // fidelización: cuándo invitar a control
  creadoEn               DateTime               @default(now())
  estudios               Estudio[]
  imagenes               ImagenEstudio[]
  ordenes                Orden[]
  citas                  Cita[]
  condiciones            CondicionDental[]
  eventos                Evento[]
  planItems              PlanTratamientoItem[]
  notasClinicas          NotaClinica[]
  facturas               Factura[]
  casosLab               CasoLaboratorio[]
  doctores               DoctorPaciente[]
  valoraciones           Valoracion[]
  leads                  Lead[]
  actividadesCrm         ActividadLead[]
  tareasCrm              TareaCRM[]
  inscripcionesSecuencia InscripcionSecuencia[]
  reservasPublicas       ReservaPublica[]
  borradoresEvolucion    BorradorEvolucion[]
  evolucionesClinicas    EvolucionClinica[]
  registrosToma          RegistroToma[]
  odontogramaHistorial   OdontogramaHistorial[]
  anticipos              Anticipo[]
  presupuestos           Presupuesto[]

  @@unique([organizationId, personaId])
  @@index([organizationId])
}

enum EstadoEstudio {
  POR_ASIGNAR
  ASIGNADO
  PUBLICADO
}

model Estudio {
  id                String          @id @default(cuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pacienteId        String?
  paciente          PacienteTenant? @relation(fields: [pacienteId], references: [id])
  doctorRemitenteId String?
  doctorRemitente   User?           @relation("DoctorRemitente", fields: [doctorRemitenteId], references: [id])
  studyInstanceUid  String          @unique
  orthancId         String          @unique
  modalidad         String?
  descripcion       String?
  fechaEstudio      DateTime?
  ordenId           String?
  orden             Orden?          @relation(fields: [ordenId], references: [id])
  superficieKey     String? // clave S3 de la malla PLY extraída (escaneo facial Carestream)
  estado            EstadoEstudio   @default(POR_ASIGNAR)
  creadoEn          DateTime        @default(now())
  actualizadoEn     DateTime        @updatedAt
  imagenes          ImagenEstudio[]
  registrosToma     RegistroToma[]

  @@index([organizationId])
}

// Perfil profesional global del doctor (uno por usuario, compartido entre centros).
model PerfilDoctor {
  userId             String  @id
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tarjetaProfesional String?
  especialidad       String?
  telefono           String?
  consultorio        String?
}

// Catálogo de servicios y precios del centro. Valores en pesos colombianos (COP).
model Servicio {
  id                     String                  @id @default(cuid())
  organizationId         String
  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoria              String // ESTUDIO_2D | TOMOGRAFIA | PAQUETE | ESCANEO | OTRO
  nombre                 String
  descripcion            String?
  precioImpreso          Int?
  precioDigital          Int?
  descuento              Int                     @default(0)
  activo                 Boolean                 @default(true)
  // Agenda en línea y anticipo.
  duracionMin            Int                     @default(30)
  holguraMin             Int                     @default(0) // pausa tras la cita (limpieza, preparación)
  reservableEnLinea      Boolean                 @default(false)
  requiereOrden          Boolean                 @default(false) // radiología: solo con orden
  anticipoTipo           AnticipoTipo            @default(NINGUNO)
  anticipoValor          Int?
  creadoEn               DateTime                @default(now())
  items                  OrdenItem[]
  tarifas                TarifaEspecial[]
  serviciosSala          ServicioSala[]
  serviciosProfesional   ServicioProfesional[]
  reservasPublicas       ReservaPublica[]
  recetasServicio        RecetaServicio[]
  citas                  Cita[]
  itemsFactura           FacturaItem[]
  itemsPresupuesto       ItemPresupuesto[]
  reglasComisionServicio ReglaComisionServicio[]

  @@index([organizationId])
}

enum EstadoOrden {
  SOLICITADA
  AGENDADA
  TOMADA
  INFORMADA
  ENTREGADA
  CANCELADA
}

enum Entrega {
  IMPRESA
  DIGITAL
}

// Orden de remisión (la ficha que llena el paciente/doctor).
model Orden {
  id                String            @id @default(cuid())
  organizationId    String
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  numero            Int // consecutivo por centro
  pacienteId        String
  paciente          PacienteTenant    @relation(fields: [pacienteId], references: [id])
  doctorRemitenteId String?
  doctorRemitente   User?             @relation("OrdenDoctor", fields: [doctorRemitenteId], references: [id])
  estado            EstadoOrden       @default(SOLICITADA)
  entrega           Entrega           @default(DIGITAL)
  convenioId        String?
  convenio          Convenio?         @relation(fields: [convenioId], references: [id], onDelete: SetNull)
  observaciones     String?
  embarazo          Boolean           @default(false)
  creadoPorId       String?
  creadoEn          DateTime          @default(now())
  actualizadoEn     DateTime          @updatedAt
  items             OrdenItem[]
  estudios          Estudio[]
  imagenes          ImagenEstudio[]
  citas             Cita[]
  facturas          Factura[]
  casosLab          CasoLaboratorio[]
  reservasPublicas  ReservaPublica[]
  registrosToma     RegistroToma[]

  @@unique([organizationId, numero])
  @@index([organizationId, estado])
}

model OrdenItem {
  id         String    @id @default(cuid())
  ordenId    String
  orden      Orden     @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  servicioId String?
  servicio   Servicio? @relation(fields: [servicioId], references: [id], onDelete: SetNull)
  nombre     String // copia del nombre al momento de la orden
  opciones   String? // FOV, zona, dientes (FDI), adicionales
  precio     Int // precio congelado al crear la orden
  descuento  Int       @default(0)
}

// Sala o equipo donde se toman los estudios (p. ej. "CS 9600", "Panorámico").
model Sala {
  id                 String             @id @default(cuid())
  organizationId     String
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  nombre             String
  color              String             @default("teal")
  activa             Boolean            @default(true)
  citas              Cita[]
  horariosAtencion   HorarioAtencion[]
  excepcionesHorario ExcepcionHorario[]
  serviciosSala      ServicioSala[]
  reservasPublicas   ReservaPublica[]
  registrosToma      RegistroToma[]

  @@index([organizationId])
}

enum EstadoCita {
  PROGRAMADA
  CONFIRMADA
  LLEGO
  EN_ATENCION
  ATENDIDA
  NO_ASISTIO
  CANCELADA
}

model Cita {
  id                  String             @id @default(cuid())
  organizationId      String
  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salaId              String
  sala                Sala               @relation(fields: [salaId], references: [id])
  pacienteId          String?
  paciente            PacienteTenant?    @relation(fields: [pacienteId], references: [id])
  ordenId             String?
  orden               Orden?             @relation(fields: [ordenId], references: [id])
  inicio              DateTime           @db.Timestamptz(3)
  fin                 DateTime           @db.Timestamptz(3)
  estado              EstadoCita         @default(PROGRAMADA)
  notas               String?
  profesionalId       String? // User.id del profesional que atiende (sin FK)
  servicioId          String?
  servicio            Servicio?          @relation(fields: [servicioId], references: [id], onDelete: SetNull)
  origen              OrigenCita         @default(INTERNA)
  // Citas anteriores a la restricción EXCLUDE que ya se cruzaban: quedan fuera de ella (ver migración agenda_publica).
  cruceHistorico      Boolean            @default(false)
  creadoEn            DateTime           @default(now())
  linksPago           LinkPago[]
  reservaPublica      ReservaPublica?
  evolucionesClinicas EvolucionClinica[]
  anticipos           Anticipo[]

  // Además: restricción EXCLUDE (btree_gist) por sala y por profesional, creada a mano en la migración agenda_publica.
  @@index([organizationId, inicio])
  @@index([profesionalId, inicio])
}

// Odontograma: una condición por diente (FDI) y superficie opcional.
model CondicionDental {
  id         String         @id @default(cuid())
  pacienteId String
  paciente   PacienteTenant @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  diente     Int
  superficie String? // M, D, O, V, L
  condicion  String // caries, restauracion, corona, ausente, implante, endodoncia
  notas      String?
  creadoEn   DateTime       @default(now())

  @@index([pacienteId])
}

// Hoja de vida del paciente y auditoría: solo se inserta, nunca se edita ni borra.
model Evento {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pacienteId     String?
  paciente       PacienteTenant? @relation(fields: [pacienteId], references: [id])
  actorId        String?
  tipo           String // p. ej. paciente.creado, orden.creada, estudio.asignado, cita.estado
  detalle        Json?
  creadoEn       DateTime        @default(now())

  @@index([organizationId, creadoEn])
  @@index([pacienteId, creadoEn])
}

// --- Módulos adaptados de OpenDentist (MIT) ---

enum EstadoPlan {
  PLANEADO
  ACEPTADO
  REALIZADO
  RECHAZADO
}

model PlanTratamientoItem {
  id          String         @id @default(cuid())
  pacienteId  String
  paciente    PacienteTenant @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  diente      Int?
  superficie  String?
  descripcion String
  valor       Int            @default(0)
  estado      EstadoPlan     @default(PLANEADO)
  notas       String?
  posicion    Int            @default(0)
  creadoEn    DateTime       @default(now())

  @@index([pacienteId])
}

model NotaClinica {
  id         String         @id @default(cuid())
  pacienteId String
  paciente   PacienteTenant @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  autorId    String?
  fecha      DateTime       @default(now())
  texto      String
  creadoEn   DateTime       @default(now())

  @@index([pacienteId, fecha])
}

enum EstadoFactura {
  ABIERTA
  PAGADA
  ANULADA
}

enum Responsable {
  PACIENTE
  DOCTOR
  CONVENIO
}

enum MedioPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  OTRO
  PASARELA
  ANTICIPO // se paga con un Anticipo previo (Pago.anticipoId)
}

// Cuenta de cobro interna (no es factura electrónica DIAN).
model Factura {
  id                        String            @id @default(cuid())
  organizationId            String
  organization              Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  numero                    Int // consecutivo por centro
  pacienteId                String?
  paciente                  PacienteTenant?   @relation(fields: [pacienteId], references: [id])
  ordenId                   String?
  orden                     Orden?            @relation(fields: [ordenId], references: [id])
  responsable               Responsable       @default(PACIENTE)
  responsableId             String? // userId del doctor cuando responsable = DOCTOR
  convenio                  String? // nombre del convenio cuando responsable = CONVENIO (texto histórico; convenioId es el vínculo real)
  convenioId                String?
  convenioRef               Convenio?         @relation(fields: [convenioId], references: [id], onDelete: SetNull)
  anuladoEn                 DateTime?
  anuladoPorId              String?
  motivoAnulacion           String?
  ultimoRecordatorioCobroEn DateTime?
  estado                    EstadoFactura     @default(ABIERTA)
  total                     Int
  fecha                     DateTime          @default(now())
  vence                     DateTime?
  notas                     String?
  items                     FacturaItem[]
  pagos                     Pago[]
  linksPago                 LinkPago[]
  notasCredito              NotaCredito[]
  cuotas                    CuotaFactura[]
  promesas                  PromesaPago[]
  itemsPresupuesto          ItemPresupuesto[]

  @@unique([organizationId, numero])
  @@index([organizationId, estado])
}

model FacturaItem {
  id            String            @id @default(cuid())
  facturaId     String
  factura       Factura           @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  descripcion   String
  cantidad      Int               @default(1)
  valorUnitario Int
  descuento     Int               @default(0)
  servicioId    String?
  servicio      Servicio?         @relation(fields: [servicioId], references: [id], onDelete: SetNull)
  profesionalId String? // odontólogo que realizó el servicio (base de la liquidación)
  liquidaciones LiquidacionItem[]

  @@index([servicioId])
}

model Pago {
  id                String            @id @default(cuid())
  facturaId         String
  factura           Factura           @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  valor             Int
  medio             MedioPago         @default(EFECTIVO)
  fecha             DateTime          @default(now())
  nota              String?
  registradoPorId   String?
  // Pago hecho por pasarela: el link que lo originó (uno a uno) y el id de la transacción en el proveedor.
  linkPagoId        String?           @unique
  linkPago          LinkPago?         @relation(fields: [linkPagoId], references: [id], onDelete: SetNull)
  referenciaExterna String?
  // Anulación auditada (anulado = anuladoEn != null). Las sumas deben excluir pagos anulados.
  anuladoEn         DateTime?
  anuladoPorId      String?
  motivoAnulacion   String?
  sesionCajaId      String?
  sesionCaja        SesionCaja?       @relation(fields: [sesionCajaId], references: [id], onDelete: Restrict)
  anticipoId        String? // medio ANTICIPO: el anticipo que se aplicó
  anticipo          Anticipo?         @relation(fields: [anticipoId], references: [id], onDelete: Restrict)
  liquidaciones     LiquidacionItem[]

  @@index([facturaId])
  @@index([sesionCajaId])
  @@index([anticipoId])
}

enum EstadoLab {
  PENDIENTE
  ENVIADO
  RECIBIDO
  ENTREGADO
  CANCELADO
}

// Trabajos de laboratorio: modelos impresos en resina 3D, guías, etc.
model CasoLaboratorio {
  id              String         @id @default(cuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pacienteId      String
  paciente        PacienteTenant @relation(fields: [pacienteId], references: [id])
  ordenId         String?
  orden           Orden?         @relation(fields: [ordenId], references: [id])
  laboratorio     String
  tipo            String
  dientes         String?
  valor           Int            @default(0)
  estado          EstadoLab      @default(PENDIENTE)
  enviado         DateTime?
  entregaEsperada DateTime?
  recibido        DateTime?
  notas           String?
  creadoEn        DateTime       @default(now())

  @@index([organizationId, estado])
}

// Equipo tratante registrado a mano (recepción/admin): relación paciente-doctor-especialidad.
// Se suma a lo derivado de órdenes y estudios. doctorId = User.id del doctor remitente (sin FK, como firmanteId).
model DoctorPaciente {
  id             String         @id @default(cuid())
  organizationId String
  pacienteId     String
  paciente       PacienteTenant @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  doctorId       String
  especialidad   String // p. ej. Ortodoncia, Diseño de sonrisa
  desde          DateTime       @db.Date
  nota           String?
  creadoPorId    String?
  creadoEn       DateTime       @default(now())

  @@index([organizationId, doctorId])
  @@index([pacienteId])
}

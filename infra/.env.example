# Copiar a infra/.env
POSTGRES_PASSWORD=cambiar
# La app (web y worker) usa el rol sin superusuario dentview_app; solo las migraciones usan el dueño.
APP_DB_PASSWORD=cambiar-app
DATABASE_URL=postgresql://dentview_app:cambiar-app@postgres:5432/dentview
MIGRATE_DATABASE_URL=postgresql://dentview:cambiar@postgres:5432/dentview
ORTHANC_DB=orthanc
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=dentview
S3_SECRET_KEY=cambiar-minio
S3_BUCKET_ESTUDIOS=dentview-estudios
S3_BUCKET_ORTHANC=dentview-orthanc
ORTHANC_URL=http://orthanc:8042
BETTER_AUTH_SECRET=cambiar-32-caracteres-minimo
# Opcional: secreto propio para cifrar en reposo (credenciales de conectores, secretos de webhooks). Vacío = usa BETTER_AUTH_SECRET.
# Definirlo DESPUÉS de tener datos cifrados invalida lo guardado (hay que recrear conectores y webhooks).
CIFRADO_SECRETO=
# Origen canónico (enlaces de los correos). Con https las cookies salen Secure (__Secure-).
BETTER_AUTH_URL=https://localhost:8443
# Otros orígenes aceptados (coma): el HTTP local de pruebas.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://127.0.0.1:8443
# Correo saliente. Local: Mailpit (sin auth ni TLS). Producción: el SMTP del proveedor con SMTP_USER/SMTP_PASS y puerto 465 o 587.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM="dent-view <no-responder@dentview.local>"
INGESTA_TENANT_SLUG=radex-demo

# Pasarelas de pago (solo desarrollo/E2E): simula las llamadas salientes en modo SANDBOX. NUNCA en producción.
# PAGOS_SIMULADO=1

# Planificador del worker: llama cada 5 min a /api/cron/notificaciones y /api/cron/crm (y los lunes 7:00 a seguimiento-doctores).
# Sin CRON_SECRET el planificador no corre. El workflow de despliegue lo genera en la VM; en local pon cualquier valor.
# CRON_SECRET=cambiar-secreto-largo
# WEB_INTERNAL_URL=http://web:3000
# CRM: ventana de envío (hora de Bogotá, 8-19 y sin domingos por defecto) y tope diario de correos por centro.
# CRM_VENTANA_DESDE=8
# CRM_VENTANA_HASTA=19
# CRM_TOPE_DIARIO=100
# SOLO pruebas locales: ignora la ventana horaria. NUNCA en producción.
# CRM_VENTANA_LIBRE=1

{
	# El contenedor no puede (ni debe) instalar la CA local en el sistema; se confía a mano (ver README).
	skip_install_trust
}

import Caddyfile.rutas

# HTTP local (pruebas, E2E).
:8080 {
	import rutas
}

# HTTPS local con la CA interna de Caddy. Sin HSTS: en localhost obligaría a HTTPS también al puerto 8080.
https://localhost:8443, https://127.0.0.1:8443 {
	tls internal
	import rutas
}
